# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Jupyter
.jupyter/
*.nbconvert.ipynb

# Large or derived data. Small source files under data/raw/ are committed on
# purpose; see data/README.md for the size and licence rule.
data/cache/
data/raw/**/*.zip

# Fashion-MNIST is 82 MB and downloads itself on first use via torchvision.
# Committing it would quadruple the size of a clone for no benefit.
data/raw/fashion-mnist/
*.idx3-ubyte
*.idx1-ubyte
data/raw/**/*.tar.gz
data/raw/**/*.h5
data/raw/**/*.parquet.tmp

# Torch / model artefacts
*.pt
*.pth
*.onnx
runs/
lightning_logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Verification sandboxes used by tooling. Never part of the book.
_scratch_verify/
_scratch*/
